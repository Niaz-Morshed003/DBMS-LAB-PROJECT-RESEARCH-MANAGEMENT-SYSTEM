# Copy to .env and fill real values (never commit .env)
GMAIL_SENDER_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password
DATABASE_URL=mysql+pymysql://root:@localhost:3306/research_management_db
SUPERADMIN_EMAIL=superadmin@uiu.ac.bd
SUPERADMIN_PASSWORD=SuperAdmin#123
# While testing with dummy addresses, set false to stop ALL real Gmail
# delivery (prevents "address not found" bounces flooding the sender inbox).
# Codes/mails print to the server console instead.
ENABLE_EMAIL_SENDING=true
# Deploy settings (only needed on hosted servers, local can ignore)
FRONTEND_URL=http://localhost:5501
# On Render/Railway set "true" (ephemeral disk, skip password JSON writes)
DISABLE_JSON_STORE=false
# Render injects PORT automatically; local default 8000
PORT=8000
